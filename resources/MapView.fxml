<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.web.WebView?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<StackPane xmlns="http://javafx.com/javafx/25"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:id="rootContainer"
           fx:controller="controller.MapController"
           prefWidth="390" prefHeight="750"
           styleClass="map-container"
           stylesheets="@/style.css">

    <AnchorPane prefWidth="390" prefHeight="750">

        <!-- MAP FULLSCREEN -->
        <WebView fx:id="webView"
                 AnchorPane.topAnchor="0"
                 AnchorPane.bottomAnchor="0"
                 AnchorPane.leftAnchor="0"
                 AnchorPane.rightAnchor="0"/>

        <!-- TOP BAR -->
        <HBox spacing="10"
              alignment="CENTER"
              styleClass="map-top-bar"
              AnchorPane.topAnchor="12"
              AnchorPane.leftAnchor="12"
              AnchorPane.rightAnchor="12">

            <ImageView fx:id="settingsBtn"
                       fitWidth="28" fitHeight="28"
                       pickOnBounds="true"
                       preserveRatio="true"
                       styleClass="icon-button">
                <image>
                    <Image url="@settings_12280787.png"/>
                </image>
            </ImageView>

            <Pane HBox.hgrow="ALWAYS"/>

            <ImageView fx:id="profileBtn"
                       fitWidth="32" fitHeight="32"
                       pickOnBounds="true"
                       preserveRatio="true"
                       styleClass="icon-button">
                <image>
                    <Image url="@user_17436294.png"/>
                </image>
            </ImageView>

        </HBox>

        <!-- BOTTOM PANEL -->
        <VBox fx:id="bottomPanel"
              spacing="12"
              prefHeight="260"
              styleClass="map-bottom-panel"
              AnchorPane.leftAnchor="0"
              AnchorPane.rightAnchor="0"
              AnchorPane.bottomAnchor="0">

            <HBox alignment="CENTER_RIGHT">
                <Button fx:id="toggleBtn"
                        text="Hide"
                        styleClass="map-control-button"/>
            </HBox>

            <Label text="MiniGo Route Finder"
                   styleClass="title-medium"/>

            <VBox spacing="6">
                <Label text="Start Location" styleClass="field-label"/>
                <ComboBox fx:id="startCombo" prefWidth="340" maxWidth="Infinity" styleClass="combo-box" prefHeight="42"/>
            </VBox>

            <VBox spacing="6">
                <Label text="Destination" styleClass="field-label"/>
                <ComboBox fx:id="endCombo" prefWidth="340" maxWidth="Infinity" styleClass="combo-box" prefHeight="42"/>
            </VBox>

            <HBox spacing="10">
                <Button fx:id="findBtn"
                        text="Request Ride"
                        styleClass="button"
                        prefHeight="42"
                        HBox.hgrow="ALWAYS"
                        maxWidth="Infinity"/>

                <Button fx:id="clearBtn"
                        text="Clear"
                        styleClass="button-secondary"
                        prefHeight="42"
                        prefWidth="90"/>
            </HBox>

        </VBox>

        <!-- FLOATING CHAT BUTTON (Right Side, Above Bottom Panel) -->
        <StackPane fx:id="chatButtonContainer"
                   visible="false"
                   managed="false"
                   pickOnBounds="false"
                   AnchorPane.bottomAnchor="310"
                   AnchorPane.rightAnchor="20">
            <Button fx:id="floatingChatButton"
                    onAction="#onToggleChatPanel"
                    prefWidth="48" prefHeight="48"
                    style="-fx-background-color: transparent;
                           -fx-background-radius: 0;
                           -fx-padding: 0;
                           -fx-cursor: hand;
                           -fx-border-color: transparent;
                           -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.4), 8, 0, 0, 2);">
                <graphic>
                    <ImageView fitWidth="48" fitHeight="48" preserveRatio="true">
                        <image>
                            <Image url="@chat.png"/>
                        </image>
                    </ImageView>
                </graphic>
            </Button>
        </StackPane>

        <!-- CHAT SIDE PANEL (Right Side) -->
        <VBox fx:id="chatSidePanel"
              visible="false"
              managed="false"
              prefWidth="360"
              pickOnBounds="false"
              viewOrder="-1.0"
              styleClass="chat-side-panel"
              style="-fx-background-color: #161B22; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.5), 15, 0, -5, 0);"
              AnchorPane.topAnchor="0"
              AnchorPane.bottomAnchor="0"
              AnchorPane.rightAnchor="0">
            <!-- Chat content will be loaded here dynamically -->
        </VBox>

    </AnchorPane>

</StackPane>

