<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.RoleSelectionController"
      alignment="TOP_CENTER"
      styleClass="role-selection-background"
      stylesheets="@/resources/style.css"
      prefWidth="400"
      prefHeight="700">

    <!-- Top Spacing -->
    <Region prefHeight="60"/>

    <!-- Logo Container with Glow Effect -->
    <StackPane styleClass="logo-container-glow">
        <VBox.margin>
            <Insets left="80" right="80"/>
        </VBox.margin>

        <!-- Glow Effect Background -->
        <Region styleClass="logo-glow-effect"/>

        <!-- Logo Image -->
        <ImageView fitWidth="120"
                   preserveRatio="true"
                   smooth="true"
                   cache="true">
            <image>
                <Image url="@/resources/Logo-removebg-preview.png"
                       backgroundLoading="false"
                       preserveRatio="true"
                       smooth="true"/>
            </image>
        </ImageView>
    </StackPane>

    <!-- Spacing after logo -->
    <Region prefHeight="40"/>

    <!-- Title: "Your journey, simplified" -->
    <Label text="Your journey, simplified"
           styleClass="role-selection-title">
        <VBox.margin>
            <Insets left="40" right="40"/>
        </VBox.margin>
    </Label>

    <!-- Spacing after title -->
    <Region prefHeight="35"/>

    <!-- Icon Row: Fast Pickup • Safe Rides -->
    <HBox alignment="CENTER"
          spacing="20"
          styleClass="features-row">
        <VBox.margin>
            <Insets left="40" right="40"/>
        </VBox.margin>

        <!-- Fast Pickup -->
        <VBox alignment="CENTER" spacing="8">
            <ImageView fitWidth="28" fitHeight="28"
                       preserveRatio="true"
                       smooth="true">
                <image>
                    <Image url="@/resources/fast.png"/>
                </image>
            </ImageView>
            <Label text="Fast Pickup" styleClass="feature-label"/>
        </VBox>

        <!-- Bullet Separator -->
        <Label text="•" styleClass="bullet-separator"/>

        <!-- Safe Rides -->
        <VBox alignment="CENTER" spacing="8">
            <ImageView fitWidth="28" fitHeight="28"
                       preserveRatio="true"
                       smooth="true">
                <image>
                    <Image url="@/resources/safe.png"/>
                </image>
            </ImageView>
            <Label text="Safe Rides" styleClass="feature-label"/>
        </VBox>
    </HBox>

    <!-- Spacing before card -->
    <Region prefHeight="45"/>

    <!-- Get Started Card Container -->
    <VBox alignment="TOP_CENTER"
          spacing="20"
          styleClass="get-started-card">
        <VBox.margin>
            <Insets left="30" right="30"/>
        </VBox.margin>
        <padding>
            <Insets top="30" bottom="35" left="25" right="25"/>
        </padding>

        <!-- Card Title -->
        <Label text="Get Started"
               styleClass="card-title"/>

        <!-- Spacing after title -->
        <Region prefHeight="5"/>

        <!-- Continue as Passenger Button -->
        <Button text="Continue as Passenger"
                fx:id="passengerButton"
                onAction="#handlePassengerSelection"
                styleClass="btn-passenger"
                maxWidth="Infinity"
                minHeight="50"
                prefHeight="50">
        </Button>

        <!-- Continue as Driver Button -->
        <Button text="Continue as Driver"
                fx:id="driverButton"
                onAction="#handleDriverSelection"
                styleClass="btn-driver"
                maxWidth="Infinity"
                minHeight="50"
                prefHeight="50">
        </Button>
    </VBox>

    <!-- Bottom Spacing -->
    <Region VBox.vgrow="ALWAYS"/>

</VBox>

