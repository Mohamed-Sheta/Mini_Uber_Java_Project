<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="controller.LoginController"
      prefWidth="400" prefHeight="750"
      alignment="TOP_CENTER"
      spacing="18"
      styleClass="content-container"
      stylesheets="@/style.css">

    <padding>
        <Insets top="50" right="30" bottom="40" left="30"/>
    </padding>

    <!-- Logo -->
    <ImageView fitWidth="110" preserveRatio="true">
        <Image url="@/Logo-removebg-preview.png"/>
    </ImageView>

    <!-- Role Label -->
    <Label fx:id="roleLabel" text="Passenger Login" styleClass="title-medium"/>

    <Region prefHeight="8"/>

    <!-- Success Message -->
    <Label fx:id="successLabel"
           text="Registration successful. Please log in."
           styleClass="label-success"
           visible="false"
           managed="false"
           wrapText="true"
           maxWidth="320"
           textAlignment="CENTER"/>

    <!-- Error Label -->
    <Label fx:id="errorLabel"
           text="Account not found. Please register."
           styleClass="label-error"
           visible="false"
           managed="false"
           wrapText="true"
           maxWidth="320"
           textAlignment="CENTER"/>

    <!-- Login Form -->
    <VBox spacing="12" alignment="CENTER">
        <!-- Email Field -->
        <VBox spacing="5" alignment="CENTER_LEFT">
            <Label text="Email" styleClass="field-label"/>
            <TextField fx:id="emailField"
                       promptText="Enter your email"
                       prefWidth="320"
                       prefHeight="44"
                       styleClass="text-field"/>
            <Label fx:id="emailErrorLabel"
                   styleClass="label-error"
                   visible="false"
                   managed="false"
                   maxWidth="320"/>
        </VBox>

        <!-- Password Field -->
        <VBox spacing="5" alignment="CENTER_LEFT">
            <Label text="Password" styleClass="field-label"/>
            <PasswordField fx:id="passwordField"
                           promptText="Enter your password"
                           prefWidth="320"
                           prefHeight="44"
                           styleClass="password-field"/>
            <Label fx:id="passwordErrorLabel"
                   styleClass="label-error"
                   visible="false"
                   managed="false"
                   maxWidth="320"/>
        </VBox>

        <!-- Login Button -->
        <Button fx:id="loginButton"
                text="Login"
                prefWidth="320"
                prefHeight="46"
                styleClass="button"
                onAction="#onLogin">
            <VBox.margin>
                <Insets top="4"/>
            </VBox.margin>
        </Button>
    </VBox>

    <!-- Register Link -->
    <HBox alignment="CENTER" spacing="5">
        <Label text="Don't have an account?" styleClass="body-text"/>
        <Label fx:id="registerLink"
               text="Register here"
               styleClass="hyperlink"
               onMouseClicked="#onRegisterClick"/>
    </HBox>

    <!-- Back Button -->
    <Button text="← Back to Role Selection"
            prefWidth="200"
            prefHeight="38"
            styleClass="button-secondary"
            onAction="#onBackToRoleSelection">
        <VBox.margin>
            <Insets top="10"/>
        </VBox.margin>
    </Button>

</VBox>

