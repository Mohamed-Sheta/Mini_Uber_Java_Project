<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="controller.LoginController"
      alignment="TOP_CENTER"
      spacing="20"
      styleClass="login-background"
      stylesheets="@/style.css">

    <padding>
        <Insets top="50" right="30" bottom="40" left="30"/>
    </padding>

    <!-- Logo Area - Centered, No Glow -->
    <ImageView fitWidth="110"
               preserveRatio="true">
        <Image url="@/Logo-removebg-preview.png"/>
    </ImageView>

    <!-- Role Label -->
    <Label fx:id="roleLabel" text="Passenger Login" styleClass="login-role-label"/>

    <!-- Spacing -->
    <Region prefHeight="10"/>

    <!-- Success Message (hidden by default) -->
    <Label fx:id="successLabel"
           text="Registration successful. Please log in."
           styleClass="login-success-label"
           visible="false"
           managed="false"
           wrapText="true"
           maxWidth="260"/>

    <!-- Error Label (hidden by default) -->
    <Label fx:id="errorLabel"
           text="Account not found. Please register."
           styleClass="login-error-label"
           visible="false"
           managed="false"
           wrapText="true"
           maxWidth="260"/>

    <!-- Login Form -->
    <VBox spacing="15" alignment="CENTER">
        <!-- Email Field -->
        <VBox spacing="5">
            <Label text="Email" styleClass="login-field-label"/>
            <TextField fx:id="emailField"
                       promptText="Enter your email"
                       prefWidth="260"
                       prefHeight="40"
                       styleClass="login-text-field"/>
            <Label fx:id="emailErrorLabel"
                   styleClass="login-field-error-label"
                   visible="false"
                   managed="false"
                   wrapText="true"
                   maxWidth="260"/>
        </VBox>

        <!-- Password Field -->
        <VBox spacing="5">
            <Label text="Password" styleClass="login-field-label"/>
            <PasswordField fx:id="passwordField"
                           promptText="Enter your password"
                           prefWidth="260"
                           prefHeight="40"
                           styleClass="login-password-field"/>
            <Label fx:id="passwordErrorLabel"
                   styleClass="login-field-error-label"
                   visible="false"
                   managed="false"
                   wrapText="true"
                   maxWidth="260"/>
        </VBox>

        <!-- Login Button -->
        <Button fx:id="loginButton"
                text="Login"
                prefWidth="260"
                prefHeight="45"
                styleClass="login-button"
                onAction="#onLogin"/>
    </VBox>

    <!-- Register Link -->
    <HBox alignment="CENTER" spacing="5">
        <Label text="Don't have an account?" styleClass="login-register-text"/>
        <Label fx:id="registerLink"
               text="Register here"
               styleClass="login-register-link"
               onMouseClicked="#onRegisterClick"/>
    </HBox>

    <!-- Back Button -->
    <Button text="← Back to Role Selection"
            prefWidth="200"
            prefHeight="35"
            styleClass="login-back-button"
            onAction="#onBackToRoleSelection"/>

</VBox>

