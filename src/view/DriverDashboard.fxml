<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.DriverDashboardController"
      prefWidth="390" prefHeight="750"
      styleClass="content-container"
      alignment="TOP_CENTER"
      spacing="20"
      stylesheets="@/style.css">

    <padding>
        <Insets top="16" bottom="20" left="20" right="20"/>
    </padding>

    <!-- Top Navigation Bar -->
    <HBox spacing="10"
          alignment="CENTER"
          styleClass="map-top-bar"
          prefHeight="48"
          minHeight="48"
          maxHeight="48">
        <padding>
            <Insets top="8" bottom="8" left="12" right="12"/>
        </padding>
        <VBox.margin>
            <Insets bottom="10"/>
        </VBox.margin>

        <ImageView fx:id="aboutBtn"
                   fitWidth="28" fitHeight="28"
                   pickOnBounds="true"
                   preserveRatio="true"
                   styleClass="icon-button">
            <image>
                <Image url="@/settings_12280787.png"/>
            </image>
        </ImageView>

        <Pane HBox.hgrow="ALWAYS"/>

        <ImageView fx:id="profileBtn"
                   fitWidth="32" fitHeight="32"
                   pickOnBounds="true"
                   preserveRatio="true"
                   styleClass="icon-button">
            <image>
                <Image url="@/user_17436294.png"/>
            </image>
        </ImageView>
    </HBox>

    <!-- Header Section -->
    <HBox alignment="CENTER_LEFT" spacing="10">
        <VBox.margin>
            <Insets bottom="10"/>
        </VBox.margin>
        <Label fx:id="welcomeLabel" text="Welcome Back, Driver" styleClass="title-large"/>
    </HBox>

    <!-- Driver Mode Toggle -->
    <VBox styleClass="card-container" spacing="12" alignment="CENTER">
        <padding>
            <Insets top="15" bottom="15" left="15" right="15"/>
        </padding>
        <Label text="Driver Status" styleClass="title-small"/>

        <!-- Custom Toggle Switch -->
        <HBox alignment="CENTER" spacing="12">
            <Label fx:id="statusLabel" text="Offline" styleClass="body-text"
                   style="-fx-text-fill: #8B92A8; -fx-font-weight: 600;"/>

            <!-- Toggle Switch Container -->
            <Pane fx:id="toggleSwitch" prefWidth="56" prefHeight="28"
                  style="-fx-background-color: #30363D; -fx-background-radius: 14; -fx-cursor: hand;">

                <!-- Toggle Circle (Thumb) -->
                <Pane fx:id="toggleThumb" layoutX="2" layoutY="2" prefWidth="24" prefHeight="24"
                      style="-fx-background-color: #8B92A8; -fx-background-radius: 12;"/>
            </Pane>
        </HBox>
    </VBox>

    <!-- Statistics Cards -->
    <HBox spacing="15" alignment="CENTER">
        <VBox.margin>
            <Insets top="10" bottom="10"/>
        </VBox.margin>

        <!-- Today's Earnings -->
        <VBox styleClass="card-container" spacing="8" alignment="CENTER" HBox.hgrow="ALWAYS">
            <padding>
                <Insets top="15" bottom="15" left="15" right="15"/>
            </padding>
            <Label text="Today's Earnings" styleClass="subtitle"/>
            <Label fx:id="todayEarningsLabel" text="0.00" styleClass="title-medium"/>
        </VBox>

        <!-- Rides Today -->
        <VBox styleClass="card-container" spacing="8" alignment="CENTER" HBox.hgrow="ALWAYS">
            <padding>
                <Insets top="15" bottom="15" left="15" right="15"/>
            </padding>
            <Label text="Rides Today" styleClass="subtitle"/>
            <Label fx:id="ridesTodayLabel" text="0" styleClass="title-medium"/>
        </VBox>
    </HBox>

    <!-- Ride Request Widget (Hidden by default) -->
    <VBox fx:id="rideRequestWidget" styleClass="card-container" spacing="12" visible="false" managed="false">
        <padding>
            <Insets top="20" bottom="20" left="20" right="20"/>
        </padding>

        <Label text="New Ride Request!" styleClass="title-medium"/>

        <VBox spacing="8">
            <HBox spacing="10">
                <Label text="Pickup:" styleClass="title-small" prefWidth="80"/>
                <Label fx:id="pickupLabel" text="Loading..." styleClass="body-text"/>
            </HBox>
            <HBox spacing="10">
                <Label text="Drop-off:" styleClass="title-small" prefWidth="80"/>
                <Label fx:id="destinationLabel" text="Loading..." styleClass="body-text"/>
            </HBox>
            <HBox spacing="10">
                <Label text="Distance:" styleClass="title-small" prefWidth="80"/>
                <Label fx:id="distanceLabel" text="0 km" styleClass="body-text"/>
            </HBox>
            <HBox spacing="10">
                <Label text="Fare:" styleClass="title-small" prefWidth="80"/>
                <Label fx:id="fareLabel" text="0.00" styleClass="title-medium"/>
            </HBox>
        </VBox>

        <Button fx:id="acceptRideButton" text="Accept Ride" styleClass="button" prefWidth="200" prefHeight="40">
            <padding>
                <Insets top="12" right="24" bottom="12" left="24"/>
            </padding>
        </Button>
    </VBox>

    <!-- No Rides Container (Shown by default) -->
    <VBox fx:id="noRidesContainer" styleClass="card-container" spacing="15" alignment="CENTER" VBox.vgrow="ALWAYS">
        <padding>
            <Insets top="40" bottom="40" left="20" right="20"/>
        </padding>
        <Label text="🚗" style="-fx-font-size: 48px;"/>
        <Label text="Waiting for Rides..." styleClass="title-medium"/>
        <Label text="Turn on your status to start receiving ride requests" styleClass="subtitle" wrapText="true" textAlignment="CENTER"/>
    </VBox>


</VBox>

