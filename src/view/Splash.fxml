<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>

<StackPane xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="controller.SplashController"
           prefWidth="390" prefHeight="750"
           alignment="CENTER"
           styleClass="splash-background"
           stylesheets="@/style.css"
           style="-fx-background-color: #000000;">

    <!-- Logo centered exactly in middle -->
    <ImageView fx:id="logoImage"
               fitWidth="170"
               preserveRatio="true"
               smooth="true"
               opacity="0"
               cache="true">
        <image>
            <Image url="@/Logo-removebg-preview.png"
                   backgroundLoading="false"
                   preserveRatio="true"
                   smooth="true"/>
        </image>
    </ImageView>

</StackPane>

