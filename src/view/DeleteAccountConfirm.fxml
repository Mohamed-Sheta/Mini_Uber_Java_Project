<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.DeleteAccountConfirmController"
      prefWidth="390" prefHeight="750"
      styleClass="content-container"
      alignment="CENTER"
      spacing="0"
      stylesheets="@/style.css">

    <padding>
        <Insets top="40" bottom="40" left="24" right="24"/>
    </padding>

    <!-- Confirmation Card -->
    <VBox styleClass="card-container" spacing="24" alignment="CENTER" maxWidth="340">
        <padding>
            <Insets top="32" bottom="32" left="28" right="28"/>
        </padding>

        <!-- Warning Icon -->
        <Label text="⚠️" style="-fx-font-size: 64px;"/>

        <!-- Title -->
        <VBox alignment="CENTER" spacing="8">
            <Label text="Delete Account?" styleClass="title-large" style="-fx-text-fill: #F85149;"/>
            <Label text="This action cannot be undone" styleClass="subtitle" style="-fx-text-fill: #8B949E;"/>
        </VBox>

        <!-- Warning Message -->
        <VBox alignment="CENTER_LEFT" spacing="12" styleClass="warning-box">
            <padding>
                <Insets top="16" bottom="16" left="16" right="16"/>
            </padding>

            <Label text="⚠️ Warning" styleClass="subtitle" style="-fx-text-fill: #F85149; -fx-font-weight: bold;"/>

            <VBox spacing="6">
                <Label text="• All your personal data will be permanently deleted"
                       styleClass="body-text"
                       wrapText="true"
                       maxWidth="260"/>
                <Label text="• Your ride history will be removed"
                       styleClass="body-text"
                       wrapText="true"
                       maxWidth="260"/>
                <Label text="• Your wallet balance will be lost"
                       styleClass="body-text"
                       wrapText="true"
                       maxWidth="260"/>
                <Label text="• This action cannot be reversed"
                       styleClass="body-text"
                       wrapText="true"
                       maxWidth="260"/>
            </VBox>
        </VBox>

        <!-- Confirmation Question -->
        <Label text="Are you absolutely sure you want to delete your account?"
               styleClass="body-text"
               wrapText="true"
               textAlignment="CENTER"
               maxWidth="280"
               style="-fx-font-weight: 600;"/>

        <!-- Error Message Label -->
        <Label fx:id="messageLabel"
               styleClass="message-label"
               visible="false"
               managed="false"
               wrapText="true"
               maxWidth="280"
               textAlignment="CENTER"/>

        <!-- Buttons -->
        <VBox spacing="12" alignment="CENTER">
            <VBox.margin>
                <Insets top="8"/>
            </VBox.margin>

            <!-- Delete Button (Danger) -->
            <Button fx:id="deleteButton"
                   text="Yes, Delete My Account"
                   styleClass="button-danger"
                   onAction="#onDelete"
                   prefWidth="280">
                <padding>
                    <Insets top="14" bottom="14" left="24" right="24"/>
                </padding>
            </Button>

            <!-- Cancel Button -->
            <Button fx:id="cancelButton"
                   text="Cancel"
                   styleClass="button-secondary"
                   onAction="#onCancel"
                   prefWidth="280">
                <padding>
                    <Insets top="14" bottom="14" left="24" right="24"/>
                </padding>
            </Button>
        </VBox>

    </VBox>

</VBox>

