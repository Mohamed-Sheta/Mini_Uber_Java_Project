<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.ChatViewController"
      prefWidth="360" minHeight="600" maxHeight="900"
      maxWidth="360"
      styleClass="content-container"
      alignment="TOP_CENTER"
      stylesheets="@/style.css">

    <padding>
        <Insets top="8" bottom="8" left="12" right="12"/>
    </padding>

    <!-- Header Bar -->
    <HBox alignment="CENTER_LEFT" spacing="12">
        <VBox.margin>
            <Insets bottom="12"/>
        </VBox.margin>
        <Label text="💬 Chat" styleClass="title-large"/>
    </HBox>

    <!-- Main Chat Card -->
    <VBox styleClass="card-container" spacing="12" VBox.vgrow="ALWAYS" maxWidth="360">
        <padding>
            <Insets top="16" bottom="16" left="18" right="18"/>
        </padding>

        <!-- Chat Title -->
        <Label text="Ride Messages" styleClass="title-small">
            <VBox.margin>
                <Insets bottom="6"/>
            </VBox.margin>
        </Label>

        <!-- Messages ScrollPane -->
        <ScrollPane fx:id="messagesScrollPane"
                    fitToWidth="true"
                    VBox.vgrow="ALWAYS"
                    prefHeight="350"
                    minHeight="200"
                    maxHeight="500"
                    style="-fx-background: #0D1117; -fx-background-color: #0D1117; -fx-border-color: #30363D; -fx-border-width: 1; -fx-border-radius: 12; -fx-background-radius: 12;">
            <VBox fx:id="messagesBox"
                  spacing="10"
                  style="-fx-padding: 14; -fx-background-color: #0D1117; -fx-background-radius: 12;"/>
        </ScrollPane>

        <!-- Separator -->
        <Separator style="-fx-background-color: #30363D;">
            <VBox.margin>
                <Insets top="4" bottom="4"/>
            </VBox.margin>
        </Separator>

        <!-- Quick Messages Section -->
        <VBox spacing="8">
            <Label text="Quick Messages" styleClass="subtitle">
                <VBox.margin>
                    <Insets bottom="4"/>
                </VBox.margin>
            </Label>

            <!-- Quick Buttons Container -->
            <VBox fx:id="quickButtonsBox" spacing="8" maxWidth="Infinity"/>
        </VBox>

        <!-- Separator -->
        <Separator style="-fx-background-color: #30363D;">
            <VBox.margin>
                <Insets top="8" bottom="8"/>
            </VBox.margin>
        </Separator>

        <!-- Custom Message Input -->
        <VBox spacing="8">
            <Label text="Type Your Message" styleClass="subtitle">
                <VBox.margin>
                    <Insets bottom="4"/>
                </VBox.margin>
            </Label>

            <HBox spacing="8" alignment="CENTER">
                <TextField fx:id="messageTextField"
                           promptText="Type a message..."
                           prefHeight="38"
                           HBox.hgrow="ALWAYS"
                           style="-fx-background-color: #161B22; -fx-text-fill: white; -fx-prompt-text-fill: #6E7681; -fx-border-color: #30363D; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 8 12; -fx-font-size: 13px;"/>
                <Button fx:id="sendButton"
                        text="Send"
                        onAction="#onSendMessage"
                        prefHeight="38"
                        minWidth="70"
                        style="-fx-background-color: #238636; -fx-text-fill: white; -fx-background-radius: 8; -fx-font-size: 13px; -fx-cursor: hand; -fx-padding: 8 14; -fx-font-weight: bold;"/>
            </HBox>
        </VBox>

        <!-- Bottom Actions -->
        <HBox spacing="10" alignment="CENTER">
            <VBox.margin>
                <Insets top="8"/>
            </VBox.margin>
            <Button fx:id="clearChatButton"
                    text="Clear Chat"
                    styleClass="button-secondary"
                    prefHeight="36"
                    minWidth="120"
                    onAction="#onClearChat"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="closeChatButton"
                    text="Close"
                    styleClass="button-secondary"
                    prefHeight="36"
                    minWidth="100"
                    onAction="#onCloseChat"/>
        </HBox>

    </VBox>

    <!-- Footer Info -->
    <Label text="Messages are temporary and not saved"
           styleClass="caption"
           style="-fx-text-fill: #6E7681;">
        <VBox.margin>
            <Insets top="12"/>
        </VBox.margin>
    </Label>

</VBox>

