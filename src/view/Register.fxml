<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>

<ScrollPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.RegisterController"
            fitToWidth="true"
            styleClass="register-scroll-pane"
            stylesheets="@/style.css">

    <VBox alignment="CENTER"
          spacing="15"
          styleClass="register-background">

        <padding>
            <Insets top="30" right="30" bottom="30" left="30"/>
        </padding>

        <!-- Logo Area - Centered, No Glow -->
        <ImageView fitWidth="90"
                   preserveRatio="true">
            <Image url="@/Logo-removebg-preview.png"/>
        </ImageView>

        <!-- Role Label -->
        <Label fx:id="roleLabel" text="Passenger Registration" styleClass="register-role-label"/>

        <!-- Spacing -->
        <Region prefHeight="5"/>

        <!-- Error Label (hidden by default) -->
        <Label fx:id="errorLabel"
               styleClass="register-error-label"
               visible="false"
               managed="false"
               wrapText="true"
               maxWidth="260"/>

        <!-- Registration Form -->
        <VBox spacing="12" alignment="CENTER">
            <!-- Name Field -->
            <VBox spacing="5">
                <Label text="Full Name" styleClass="register-field-label"/>
                <TextField fx:id="nameField"
                           promptText="Enter your full name"
                           prefWidth="260"
                           prefHeight="40"
                           styleClass="register-text-field"/>
                <Label fx:id="nameErrorLabel"
                       styleClass="register-field-error-label"
                       visible="false"
                       managed="false"
                       wrapText="true"
                       maxWidth="260"/>
            </VBox>

            <!-- Phone Field -->
            <VBox spacing="5">
                <Label text="Phone Number" styleClass="register-field-label"/>
                <TextField fx:id="phoneField"
                           promptText="e.g. 01123456789"
                           prefWidth="260"
                           prefHeight="40"
                           styleClass="register-text-field"/>
                <Label fx:id="phoneErrorLabel"
                       styleClass="register-field-error-label"
                       visible="false"
                       managed="false"
                       wrapText="true"
                       maxWidth="260"/>
            </VBox>

            <!-- Email Field -->
            <VBox spacing="5">
                <Label text="Email" styleClass="register-field-label"/>
                <TextField fx:id="emailField"
                           promptText="Enter your email"
                           prefWidth="260"
                           prefHeight="40"
                           styleClass="register-text-field"/>
                <Label fx:id="emailErrorLabel"
                       styleClass="register-field-error-label"
                       visible="false"
                       managed="false"
                       wrapText="true"
                       maxWidth="260"/>
            </VBox>

            <!-- Password Field -->
            <VBox spacing="5">
                <Label text="Password" styleClass="register-field-label"/>
                <PasswordField fx:id="passwordField"
                               promptText="Enter your password"
                               prefWidth="260"
                               prefHeight="40"
                               styleClass="register-password-field"/>
                <Label fx:id="passwordErrorLabel"
                       styleClass="register-field-error-label"
                       visible="false"
                       managed="false"
                       wrapText="true"
                       maxWidth="260"/>
            </VBox>

            <!-- Confirm Password Field -->
            <VBox spacing="5">
                <Label text="Confirm Password" styleClass="register-field-label"/>
                <PasswordField fx:id="confirmPasswordField"
                               promptText="Re-enter your password"
                               prefWidth="260"
                               prefHeight="40"
                               styleClass="register-password-field"/>
                <Label fx:id="confirmPasswordErrorLabel"
                       styleClass="register-field-error-label"
                       visible="false"
                       managed="false"
                       wrapText="true"
                       maxWidth="260"/>
            </VBox>

            <!-- Driver-specific fields (hidden for passengers) -->
            <VBox fx:id="driverFieldsBox" spacing="12" visible="false" managed="false">
                <!-- License Plate -->
                <VBox spacing="5">
                    <Label text="License Plate" styleClass="register-field-label"/>
                    <TextField fx:id="licensePlateField"
                               promptText="Enter license plate"
                               prefWidth="260"
                               prefHeight="40"
                               styleClass="register-text-field"/>
                    <Label fx:id="licensePlateErrorLabel"
                           styleClass="register-field-error-label"
                           visible="false"
                           managed="false"
                           wrapText="true"
                           maxWidth="260"/>
                </VBox>

                <!-- Car Model -->
                <VBox spacing="5">
                    <Label text="Car Model" styleClass="register-field-label"/>
                    <TextField fx:id="carModelField"
                               promptText="Enter car model"
                               prefWidth="260"
                               prefHeight="40"
                               styleClass="register-text-field"/>
                    <Label fx:id="carModelErrorLabel"
                           styleClass="register-field-error-label"
                           visible="false"
                           managed="false"
                           wrapText="true"
                           maxWidth="260"/>
                </VBox>
            </VBox>

            <!-- Register Button -->
            <Button fx:id="registerButton"
                    text="Register"
                    prefWidth="260"
                    prefHeight="45"
                    styleClass="register-button"
                    onAction="#onRegister"/>
        </VBox>

        <!-- Login Link -->
        <HBox alignment="CENTER" spacing="5">
            <Label text="Already have an account?" styleClass="register-login-text"/>
            <Label fx:id="loginLink"
                   text="Login here"
                   styleClass="register-login-link"
                   onMouseClicked="#onLoginClick"/>
        </HBox>

    </VBox>
</ScrollPane>

