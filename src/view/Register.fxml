<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="controller.RegisterController"
      prefWidth="400" prefHeight="750"
      alignment="TOP_CENTER"
      spacing="12"
      styleClass="content-container"
      stylesheets="@/style.css">

    <padding>
        <Insets top="25" right="30" bottom="25" left="30"/>
    </padding>

    <!-- Logo -->
    <ImageView fitWidth="90" preserveRatio="true">
        <Image url="@/Logo-removebg-preview.png"/>
    </ImageView>

    <!-- Role Label -->
    <Label fx:id="roleLabel" text="Passenger Registration" styleClass="title-medium"/>

    <!-- Error Label -->
    <Label fx:id="errorLabel"
           styleClass="label-error"
           visible="false"
           managed="false"
           wrapText="true"
           maxWidth="320"
           textAlignment="CENTER"/>

    <!-- Registration Form -->
    <VBox spacing="10" alignment="CENTER">
        <!-- Name Field -->
        <VBox spacing="5" alignment="CENTER_LEFT">
            <Label text="Full Name" styleClass="field-label"/>
            <TextField fx:id="nameField"
                       promptText="Enter your full name"
                       prefWidth="320"
                       prefHeight="44"
                       styleClass="text-field"/>
            <Label fx:id="nameErrorLabel"
                   styleClass="label-error"
                   visible="false"
                   managed="false"
                   maxWidth="320"/>
        </VBox>

        <!-- Phone Field -->
        <VBox spacing="5" alignment="CENTER_LEFT">
            <Label text="Phone Number" styleClass="field-label"/>
            <TextField fx:id="phoneField"
                       promptText="e.g. 01123456789"
                       prefWidth="320"
                       prefHeight="44"
                       styleClass="text-field"/>
            <Label fx:id="phoneErrorLabel"
                   styleClass="label-error"
                   visible="false"
                   managed="false"
                   maxWidth="320"/>
        </VBox>

        <!-- Email Field -->
        <VBox spacing="5" alignment="CENTER_LEFT">
            <Label text="Email" styleClass="field-label"/>
            <TextField fx:id="emailField"
                       promptText="Enter your email"
                       prefWidth="320"
                       prefHeight="44"
                       styleClass="text-field"/>
            <Label fx:id="emailErrorLabel"
                   styleClass="label-error"
                   visible="false"
                   managed="false"
                   maxWidth="320"/>
        </VBox>

        <!-- Password Field -->
        <VBox spacing="5" alignment="CENTER_LEFT">
            <Label text="Password" styleClass="field-label"/>
            <PasswordField fx:id="passwordField"
                           promptText="Enter your password"
                           prefWidth="320"
                           prefHeight="44"
                           styleClass="password-field"/>
            <Label fx:id="passwordErrorLabel"
                   styleClass="label-error"
                   visible="false"
                   managed="false"
                   maxWidth="320"/>
        </VBox>

        <!-- Confirm Password Field -->
        <VBox spacing="5" alignment="CENTER_LEFT">
            <Label text="Confirm Password" styleClass="field-label"/>
            <PasswordField fx:id="confirmPasswordField"
                           promptText="Re-enter your password"
                           prefWidth="320"
                           prefHeight="44"
                           styleClass="password-field"/>
            <Label fx:id="confirmPasswordErrorLabel"
                   styleClass="label-error"
                   visible="false"
                   managed="false"
                   maxWidth="320"/>
        </VBox>

        <!-- Driver Fields -->
        <VBox fx:id="driverFieldsBox" spacing="10" visible="false" managed="false" alignment="CENTER">
            <VBox spacing="5" alignment="CENTER_LEFT">
                <Label text="License Plate" styleClass="field-label"/>
                <TextField fx:id="licensePlateField"
                           promptText="Enter license plate"
                           prefWidth="320"
                           prefHeight="44"
                           styleClass="text-field"/>
                <Label fx:id="licensePlateErrorLabel"
                       styleClass="label-error"
                       visible="false"
                       managed="false"
                       maxWidth="320"/>
            </VBox>

            <VBox spacing="5" alignment="CENTER_LEFT">
                <Label text="Car Model" styleClass="field-label"/>
                <TextField fx:id="carModelField"
                           promptText="Enter car model"
                           prefWidth="320"
                           prefHeight="44"
                           styleClass="text-field"/>
                <Label fx:id="carModelErrorLabel"
                       styleClass="label-error"
                       visible="false"
                       managed="false"
                       maxWidth="320"/>
            </VBox>
        </VBox>

        <!-- Register Button -->
        <Button fx:id="registerButton"
                text="Register"
                prefWidth="320"
                prefHeight="46"
                styleClass="button"
                onAction="#onRegister">
            <VBox.margin>
                <Insets top="8"/>
            </VBox.margin>
        </Button>
    </VBox>

    <!-- Login Link -->
    <HBox alignment="CENTER" spacing="5">
        <VBox.margin>
            <Insets top="6"/>
        </VBox.margin>
        <Label text="Already have an account?" styleClass="body-text"/>
        <Label fx:id="loginLink"
               text="Login here"
               styleClass="hyperlink"
               onMouseClicked="#onLoginClick"/>
    </HBox>

</VBox>

