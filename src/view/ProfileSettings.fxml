<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.ProfileSettingsController"
      prefWidth="390" prefHeight="750"
      styleClass="content-container"
      alignment="TOP_CENTER"
      spacing="0"
      stylesheets="@/style.css">

    <padding>
        <Insets top="10" bottom="14" left="16" right="16"/>
    </padding>

    <!-- Header with Back Button -->
    <HBox alignment="CENTER_LEFT" spacing="8">
        <VBox.margin>
            <Insets bottom="14"/>
        </VBox.margin>
        <Button fx:id="backButton" text="←" styleClass="back-button" onAction="#onBackToProfile"/>
        <Label text="Settings" styleClass="title-large"/>
    </HBox>

    <!-- Driver Balance KPI (Drivers only) -->
    <VBox fx:id="driverBalanceCard" styleClass="elevated-card" spacing="6" alignment="CENTER"
          visible="false" managed="false" prefWidth="340" maxWidth="340">
        <VBox.margin>
            <Insets bottom="12"/>
        </VBox.margin>
        <padding>
            <Insets top="14" bottom="14" left="20" right="20"/>
        </padding>
        <HBox alignment="CENTER" spacing="8">
            <Label text="💰" style="-fx-font-size: 20px;"/>
            <Label text="Balance:" styleClass="field-label" style="-fx-font-size: 14px; -fx-text-fill: #8B92A8;"/>
            <Label fx:id="driverBalanceLabel" text="0.00 EGP" styleClass="stat-value"
                   style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #E6EDF3;"/>
        </HBox>
    </VBox>

    <!-- Settings Options Card -->
    <VBox styleClass="card-container" spacing="0" alignment="TOP_LEFT" maxWidth="360">
        <padding>
            <Insets top="6" bottom="6" left="0" right="0"/>
        </padding>

        <!-- Add Funds Button (Passengers only) -->
        <Button fx:id="addFundsButton" text="💰 Add Funds" styleClass="settings-item-button" onAction="#onAddFunds" alignment="CENTER_LEFT">
            <padding>
                <Insets top="14" bottom="14" left="20" right="20"/>
            </padding>
        </Button>

        <Region fx:id="addFundsDivider" prefHeight="1" styleClass="divider"/>

        <!-- Change Password Button -->
        <Button fx:id="changePasswordButton" text="🔒 Change Password" styleClass="settings-item-button" onAction="#onChangePassword" alignment="CENTER_LEFT">
            <padding>
                <Insets top="14" bottom="14" left="20" right="20"/>
            </padding>
        </Button>

        <Region prefHeight="1" styleClass="divider"/>

        <!-- Report a Ride Button (Passengers only) -->
        <Button fx:id="reportRideButton" text="📝 Report a Ride" styleClass="settings-item-button" onAction="#onReportRide" alignment="CENTER_LEFT">
            <padding>
                <Insets top="14" bottom="14" left="20" right="20"/>
            </padding>
        </Button>

        <Region fx:id="reportRideDivider" prefHeight="1" styleClass="divider"/>

        <!-- Delete Account Button -->
        <Button fx:id="deleteAccountButton" text="🗑️ Delete Account" styleClass="settings-item-button-danger" onAction="#onDeleteAccount" alignment="CENTER_LEFT">
            <padding>
                <Insets top="14" bottom="14" left="20" right="20"/>
            </padding>
        </Button>

        <Region prefHeight="1" styleClass="divider"/>

        <!-- Logout Button -->
        <Button fx:id="logoutButton" text="🚪 Logout" styleClass="settings-item-button" onAction="#onLogout" alignment="CENTER_LEFT">
            <padding>
                <Insets top="14" bottom="14" left="20" right="20"/>
            </padding>
        </Button>
    </VBox>

    <!-- App Version -->
    <Label text="Version 1.0" styleClass="caption" textAlignment="CENTER">
        <VBox.margin>
            <Insets top="20"/>
        </VBox.margin>
    </Label>

</VBox>

