<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<VBox xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.ChangePasswordController"
      prefWidth="390" prefHeight="750"
      styleClass="content-container"
      alignment="TOP_CENTER"
      spacing="0"
      stylesheets="@/style.css">
    <padding>
        <Insets top="12" bottom="16" left="16" right="16"/>
    </padding>
    <!-- Header with Back Button -->
    <HBox alignment="CENTER_LEFT" spacing="8">
        <VBox.margin>
            <Insets bottom="16"/>
        </VBox.margin>
        <Button fx:id="backButton" text="←" styleClass="back-button" onAction="#onBack"/>
        <Label text="Change Password" styleClass="title-large"/>
    </HBox>
    <!-- Change Password Form Card -->
    <VBox styleClass="card-container" spacing="20" alignment="TOP_CENTER" maxWidth="350">
        <padding>
            <Insets top="24" bottom="24" left="24" right="24"/>
        </padding>
        <!-- Icon/Title Section -->
        <VBox alignment="CENTER" spacing="8">
            <Label text="🔐" style="-fx-font-size: 42px;"/>
            <Label text="Update Your Password" styleClass="title-medium"/>
            <Label text="Enter your current password and choose a new one" styleClass="caption" wrapText="true" textAlignment="CENTER"/>
        </VBox>
        <!-- Current Password -->
        <VBox spacing="8">
            <Label text="Current Password" styleClass="field-label"/>
            <PasswordField fx:id="currentPasswordField"
                          promptText="Enter current password"
                          styleClass="input-field"
                          prefWidth="300"/>
        </VBox>
        <!-- New Password -->
        <VBox spacing="8">
            <Label text="New Password" styleClass="field-label"/>
            <PasswordField fx:id="newPasswordField"
                          promptText="Enter new password (min 8 characters)"
                          styleClass="input-field"
                          prefWidth="300"/>
        </VBox>
        <!-- Confirm New Password -->
        <VBox spacing="8">
            <Label text="Confirm New Password" styleClass="field-label"/>
            <PasswordField fx:id="confirmPasswordField"
                          promptText="Re-enter new password"
                          styleClass="input-field"
                          prefWidth="300"/>
        </VBox>
        <!-- Message Label -->
        <Label fx:id="messageLabel"
               styleClass="message-label"
               visible="false"
               managed="false"
               wrapText="true"
               maxWidth="300"
               textAlignment="CENTER"/>
        <!-- Change Password Button -->
        <Button fx:id="changePasswordButton"
                text="Change Password"
                styleClass="button"
                onAction="#onChangePassword"
                prefWidth="300">
            <padding>
                <Insets top="12" bottom="12" left="24" right="24"/>
            </padding>
        </Button>
        <!-- Security Tips -->
        <VBox spacing="6" alignment="CENTER_LEFT">
            <VBox.margin>
                <Insets top="8"/>
            </VBox.margin>
            <Label text="Password Tips:" styleClass="subtitle"/>
            <Label text="• Use at least 8 characters" styleClass="caption"/>
            <Label text="• Mix letters, numbers, and symbols" styleClass="caption"/>
            <Label text="• Avoid common words or patterns" styleClass="caption"/>
        </VBox>

    </VBox>
</VBox>

