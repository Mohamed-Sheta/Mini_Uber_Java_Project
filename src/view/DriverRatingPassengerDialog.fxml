<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.DriverRatingPassengerDialogController"
      prefWidth="350" prefHeight="280"
      alignment="CENTER" spacing="25"
      style="-fx-background-color: #0B0F17; -fx-background-radius: 15;">

    <padding>
        <Insets top="30" right="30" bottom="30" left="30"/>
    </padding>
    <!-- Title -->
    <Label fx:id="titleLabel" text="Rate Your Passenger"
           style="-fx-text-fill: #E6EDF3; -fx-font-size: 20px; -fx-font-weight: 600;"/>
    <!-- Message -->
    <Label text="How was your experience with this passenger?"
           style="-fx-text-fill: #8B92A8; -fx-font-size: 13px; -fx-text-alignment: center;"
           wrapText="true" maxWidth="280"/>
    <!-- Stars Container -->
    <HBox fx:id="starsContainer" alignment="CENTER" spacing="8">
        <VBox.margin>
            <Insets top="10" bottom="10"/>
        </VBox.margin>
    </HBox>
    <!-- Buttons -->
    <HBox alignment="CENTER" spacing="15">
        <VBox.margin>
            <Insets top="15"/>
        </VBox.margin>
        <Button fx:id="skipButton" text="Skip"
                prefWidth="120" prefHeight="40"
                style="-fx-background-color: #30363D; -fx-text-fill: #8B92A8; -fx-background-radius: 8; -fx-cursor: hand; -fx-font-size: 13px; -fx-font-weight: 600;">
            <padding>
                <Insets top="10" right="20" bottom="10" left="20"/>
            </padding>
        </Button>
        <Button fx:id="submitButton" text="Submit"
                prefWidth="120" prefHeight="40"
                style="-fx-background-color: #238636; -fx-text-fill: #FFFFFF; -fx-background-radius: 8; -fx-cursor: hand; -fx-font-size: 13px; -fx-font-weight: 600;">
            <padding>
                <Insets top="10" right="20" bottom="10" left="20"/>
            </padding>
        </Button>
    </HBox>
</VBox>

